# Free-threaded CPython for the GIL experiment, for machines where a local
# `uv python install 3.13t` is not an option. There is no official free-threaded
# python image, so the interpreters come from uv.
#
#   docker build -f bench/Dockerfile.freethreaded -t rls-bench-ft .
#   docker run --rm -v "$PWD/data:/work/data:ro" -v "$PWD/bench/results:/work/bench/results" \
#       rls-bench-ft --threads 1,2,4,8 --requests 400000 --reps 5
FROM ghcr.io/astral-sh/uv:0.8.22 AS uv

FROM debian:bookworm-slim
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PYTHON_INSTALL_DIR=/opt/python UV_LINK_MODE=copy
RUN uv python install 3.13 3.13t \
    && uv venv /opt/std --python 3.13 \
    && uv pip install --python /opt/std/bin/python requests \
    && ln -s "$(uv python find 3.13t)" /usr/local/bin/python3.13t
WORKDIR /work
COPY bench/loadgen.py bench/common.py bench/run_threads.py bench/
ENTRYPOINT ["/opt/std/bin/python", "bench/run_threads.py", "--standard-python", "/opt/std/bin/python", "--ft-python", "/usr/local/bin/python3.13t"]
